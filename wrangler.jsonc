{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farsha-system",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "farshastudio.com",
      "custom_domain": true
    },
    {
      "pattern": "titipsewa.farshastudio.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://images.farshastudio.com",
    "CONSIGNMENT_HOST": "titipsewa.farshastudio.com",
    "CONSIGNMENT_BASE_URL": "https://titipsewa.farshastudio.com",
    "RESEND_FROM": "Farsha Studio <titipsewa@farshastudio.com>",
    "CONSIGNOR_TIER_THRESHOLD": "3",
    "CONSIGNOR_RATE_LOW": "40",
    "CONSIGNOR_RATE_HIGH": "50",
    "CONSIGNOR_MIN_PAYOUT": "100000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farsha-system-db",
      "database_id": "b329750d-070f-4525-a41b-43576f0ee38f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "farsha-catalog-images"
    }
  ],
  "services": [
    {
      // Self-reference service binding. The service name must match this Worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "farsha-system"
    }
  ]
}
